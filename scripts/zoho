#!/usr/bin/env bun
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { spawnSync } = require("node:child_process");

const cli = path.join(os.homedir(), ".pi", "agent", "skills", "zoho-mcp", "zoho.mjs");
if (!fs.existsSync(cli)) {
  console.error("zoho: skill missing. Run make install in the my-pi repository.");
  process.exit(1);
}
const result = spawnSync(process.execPath, [cli, ...process.argv.slice(2)], { stdio: "inherit" });
if (result.error) console.error(`zoho: ${result.error.code || "cannot start CLI"}`);
process.exitCode = result.status ?? 1;
